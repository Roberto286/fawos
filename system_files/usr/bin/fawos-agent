#!/bin/bash
set -euo pipefail
CONF="$HOME/.config/fawos/agent"
AGENTS=(omp claude opencode codex pi)

choose() {
  mkdir -p "$(dirname "$CONF")"
  printf '%s\n' "${AGENTS[@]}" | fzf --prompt="Agente di default: " > "$CONF.tmp"
  mv "$CONF.tmp" "$CONF"
}

if [ "${1:-}" = "--choose" ]; then
  shift
  choose
fi
[ -s "$CONF" ] || choose

exec "$(cat "$CONF")" "$@"
