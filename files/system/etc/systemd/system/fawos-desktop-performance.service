[Unit]
Description=Use the performance power profile on desktop chassis
Documentation=man:powerprofilesctl(1) man:systemd.unit(5)
Wants=power-profiles-daemon.service
After=power-profiles-daemon.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/sh -c 'test "$(hostnamectl chassis)" = desktop'
ExecStart=/usr/bin/powerprofilesctl set performance

[Install]
WantedBy=multi-user.target
