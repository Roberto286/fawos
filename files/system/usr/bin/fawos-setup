#!/usr/bin/bash
set -uo pipefail

if (( $# != 0 )); then
    printf 'Usage: fawos-setup\n' >&2
    exit 2
fi

if (( EUID == 0 )); then
    printf 'Run fawos-setup as your regular user, without sudo.\n' >&2
    exit 2
fi

trap 'exit 130' INT
trap 'exit 143' TERM

failed=()

# EOF or Enter means no.
ask() { local reply; read -r -p "$1 [y/N] " reply || return 1; [[ $reply == [yY]* ]]; }

# True when the flatpak Thunderbird already has an account in its default profile.
thunderbird_has_account() {
    local prefs
    for prefs in "$HOME"/.var/app/org.mozilla.thunderbird/.thunderbird/*/prefs.js; do
        [[ -e $prefs ]] || continue
        grep -q 'mail\.account\.account[0-9][0-9]*\.server' "$prefs" && return 0
    done
    return 1
}

printf '\n== SSH key / GitHub ==\n'
key=$HOME/.ssh/id_ed25519
step_ok=1
if [[ ! -e $key ]] && ask "Create an SSH key ($key)?"; then
    mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
    ssh-keygen -t ed25519 -C "$USER@$(hostname)" -f "$key" || step_ok=0
fi
if [[ -e $key.pub ]] && ask 'Upload the key to GitHub with gh?'; then
    if ! gh auth status >/dev/null 2>&1; then
        gh auth login --git-protocol ssh --web || step_ok=0
    fi
    gh ssh-key add "$key.pub" --title "fawos $(hostname)" || step_ok=0
fi
(( step_ok )) || failed+=('SSH key / GitHub')

printf '\n== Dotfiles remote ==\n'
if chezmoi source-path >/dev/null 2>&1; then
    # </dev/null: ssh would otherwise swallow the answers meant for the prompts below.
    if ssh -o StrictHostKeyChecking=accept-new -T git@github.com </dev/null 2>&1 | grep -q 'successfully authenticated'; then
        if ask 'Switch dotfiles remote to SSH?'; then
            if ! chezmoi git -- remote set-url origin git@github.com:roberto286/dotfiles.git; then
                failed+=('chezmoi remote')
            fi
        fi
    else
        printf 'GitHub SSH auth not working; skipping chezmoi remote switch.\n'
    fi
else
    printf 'No chezmoi source directory; skipping.\n'
fi

printf '\n== Default shell ==\n'
fish=/usr/bin/fish
current=$(getent passwd "$USER" | cut -d: -f7)
if [[ $current == "$fish" ]]; then
    printf 'fish is already your default shell; skipping.\n'
elif [[ ! -x $fish ]]; then
    printf 'fish is not installed; skipping.\n'
elif ask 'Make fish your default shell?'; then
    # chsh asks for your password. The change applies from the next login.
    chsh -s "$fish" || failed+=('Default shell')
fi

printf '\n== Email accounts ==\n'
if thunderbird_has_account; then
    printf 'Thunderbird already has an account configured; skipping.\n'
elif [[ -z ${WAYLAND_DISPLAY:-}${DISPLAY:-} ]]; then
    printf 'No graphical session; skipping email setup.\n'
elif ! flatpak info org.mozilla.thunderbird >/dev/null 2>&1; then
    printf 'Thunderbird is not installed; install it from Bazaar, then rerun fawos-setup.\n'
elif ask 'Set up your email accounts in Thunderbird now?'; then
    # Detached: the wizard keeps going while Thunderbird shows its account setup.
    if setsid -f flatpak run org.mozilla.thunderbird >/dev/null 2>&1; then
        printf 'Thunderbird is starting; finish the account setup in its window.\n'
    else
        failed+=('Email accounts')
    fi
fi

cat <<'EOF'

== Tips ==
  - fawos-update updates image, flatpaks, dotfiles, and mise. Reboot after it.
  - sudo bootc rollback returns to the previous image.
  - snapper 'home' config snapshots /var/home. Use btrfs-assistant or 'snapper -c home list'.
  - Flatseal manages flatpak permissions. Warehouse manages flatpaks.
  - Dotfiles changed by apps (DMS settings, mise use -g, fisher, Lazy) stay local until 'chezmoi re-add'; fawos-update lists them.
  - Rerun fawos-setup any time.
EOF

mkdir -p "$HOME/.local/state/fawos" && touch "$HOME/.local/state/fawos/setup-done"

rc=0
if (( ${#failed[@]} != 0 )); then
    printf '\nSetup steps failed:\n' >&2
    printf '  - %s\n' "${failed[@]}" >&2
    rc=1
fi

read -r -p 'Press Enter to close. ' _ || true
exit "$rc"
